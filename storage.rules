rules_version = '2';

// RPelago — Firebase Storage.
//
// The only thing stored here is casino Slot-Fill manifests: one Archipelago
// player YAML per seat, owner-scoped. Everything else is denied. YAML is inert
// text (never executed on our side) — the concern is access scoping and storage
// hygiene, not code execution.
service firebase.storage {
  match /b/{bucket}/o {

    // casino/{seasonId}/{missionId}/{uid}.yaml — one object per seat, replaced on
    // re-submit. Only the owning player may read/write/delete their own file.
    // Admin review happens via the Firebase console / Admin SDK (both bypass
    // these rules); adminId lives in RTDB, which Storage rules cannot read, so
    // there is deliberately no admin clause here.
    match /casino/{seasonId}/{missionId}/{fileName} {
      allow read, delete: if request.auth != null
        && fileName == request.auth.uid + '.yaml';

      // 1 MB cap: real Archipelago YAMLs (multi-game, weighted options, plando) can
      // run past 100 KB, but a legit config is never megabytes — this fits genuine
      // files with headroom while hard-blocking abuse (a >10 MB file is bad data or
      // malicious). Firebase evaluates this before storing, so an oversized upload
      // never lands. Mirror the value in src/firebase/casinoYaml.ts (MAX_YAML_BYTES).
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.yaml'
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('(text/.*|application/(x-)?yaml|application/octet-stream)');
    }

    // yaml/{seasonId}/{kind}/{containerId}/{uid}.yaml — S2's universal config
    // path: every challenge AND mission join attaches one (kind = challenge |
    // mission). Same owner-scoping and same cap as the casino block above; the
    // two are separate only because the casino keeps its legacy path so S1.5's
    // archived seats stay readable.
    //
    // NOTE containerId may contain ':' — an interior tile coord is `G1:2_3`
    // (see docs/season-2-map-plan.md §3.3). A single path segment matches it
    // fine; this must NOT be tightened to an alphanumeric pattern.
    //
    // As with casino, there is deliberately no admin clause: adminId lives in
    // RTDB, which Storage rules cannot read. Admin review goes through the
    // Admin SDK, which bypasses these rules.
    match /yaml/{seasonId}/{kind}/{containerId}/{fileName} {
      allow read, delete: if request.auth != null
        && fileName == request.auth.uid + '.yaml';

      // Mirror the cap in src/firebase/yamlPaths.ts (MAX_YAML_BYTES).
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.yaml'
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('(text/.*|application/(x-)?yaml|application/octet-stream)');
    }

    // Default-deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
