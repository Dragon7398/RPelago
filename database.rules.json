{
  "rules": {
    // ═══════════════════════════════════════════════════════════════════════
    // config — global, season-independent
    //
    // A season is PUBLICLY READABLE if and only if it has an entry in
    // config/seasonList. Draft seasons are deliberately ABSENT from that
    // (public) list and are instead described in config/draftSeasons, which
    // only admin + alpha users may read — so players cannot even discover that
    // an unlaunched season exists, let alone read its content.
    // ═══════════════════════════════════════════════════════════════════════
    "config": {
      "adminId": {
        ".read":  true,
        ".write": "auth != null && root.child('config/adminId').val() === auth.uid"
      },
      "activeSeasonId": {
        ".read":  true,
        ".write": "auth != null && root.child('config/adminId').val() === auth.uid"
      },
      "minClientVersion": {
        // Version gate: client force-reloads when its build is older than this.
        ".read":  true,
        ".write": "auth != null && root.child('config/adminId').val() === auth.uid"
      },
      "seasonList": {
        // PUBLIC. Holds only active / closing / archived seasons — never drafts.
        // { label, shell: "map"|"casino", status: "active"|"closing"|"archived" }
        ".read":  true,
        ".write": "auth != null && root.child('config/adminId').val() === auth.uid"
      },
      "draftSeasons": {
        // PRIVATE. { label, shell } for unlaunched seasons. Admin + alpha only.
        ".read":  "auth != null && (root.child('config/adminId').val() === auth.uid || root.child('config/alphaUsers').child(auth.uid).exists())",
        ".write": "auth != null && root.child('config/adminId').val() === auth.uid"
      },
      "alphaUsers": {
        // PRIVATE. Allowlist of uids that may read AND playtest draft seasons.
        ".read":  "auth != null && (root.child('config/adminId').val() === auth.uid || root.child('config/alphaUsers').child(auth.uid).exists())",
        ".write": "auth != null && root.child('config/adminId').val() === auth.uid"
      },
      "bannedDiscordIds": {
        // PRIVATE, SERVER-WRITTEN. Keyed by Discord snowflake ID (NOT username —
        // handles are renameable, snowflakes are not). exchangeDiscordCode reads
        // this BEFORE minting an Auth account, so a banned ID never becomes a
        // Firebase identity at all. { reason, ts, by, lastAttemptAt?, handle? }
        //
        // ADMIN-READ ONLY: this is a roster of banned Discord IDs, so it must
        // never be world-readable. `.write` is false for EVERYONE — all writes go
        // through adminBanDiscordId / adminUnbanDiscordId, which also disable the
        // Auth account and the per-season player flag. The Admin SDK bypasses
        // rules, so the server retains full access.
        ".read":  "auth != null && root.child('config/adminId').val() === auth.uid",
        ".write": false
      }
    },

    // ═══════════════════════════════════════════════════════════════════════
    // seasonSecrets — server-owned data that must NEVER be publicly readable.
    //
    // ⚠️ THIS NODE EXISTS BECAUSE RTDB READ RULES CASCADE DOWNWARD.
    // A `.read: true` at an ancestor CANNOT be revoked by a descendant. The
    // season tree is world-readable, so ANY secret placed inside it is exposed
    // (this is exactly how the casino deck/hand leak happened under `game/`).
    //
    // Therefore: NO `.read` or `.write` is granted at this node or any node
    // above the leaves below. Default-deny stands, and only the specific leaf
    // grants apply. Cloud Functions use the Admin SDK, which bypasses rules
    // entirely, so the server retains full access.
    //
    // RULE OF THUMB: if it must not be public, it CANNOT live under seasons/.
    // ═══════════════════════════════════════════════════════════════════════
    "seasonSecrets": {
      "$seasonId": {
        "missions": {
          "$missionId": {
            "participants": {
              "$uid": {
                "deck": {
                  // The remaining draw deck. Readable by NOBODY on the client —
                  // not even its owner. Seeing it would let a player engineer
                  // their hand. Server-only.
                  ".read":  false,
                  ".write": false
                },
                "hand": {
                  // The player's own cards, readable only by that player so the
                  // table UI can recover after a reload. Writes are server-only.
                  ".read":  "auth != null && auth.uid === $uid",
                  ".write": false
                },
                "hole": {
                  // Hold 'Em: the seat's 2 hole cards, kept past play-on so a forming
                  // resubmit can rebuild the pool. Owner-read only, like `hand`.
                  ".read":  "auth != null && auth.uid === $uid",
                  ".write": false
                }
              }
            }
          }
        }
      }
    },

    // ═══════════════════════════════════════════════════════════════════════
    // seasons — one subtree per season. Public read once listed in seasonList.
    // ═══════════════════════════════════════════════════════════════════════
    "seasons": {
      "$seasonId": {
        // Readable if the season is public (listed), or you are admin/alpha.
        ".read": "root.child('config/seasonList').child($seasonId).exists() || (auth != null && (root.child('config/adminId').val() === auth.uid || root.child('config/alphaUsers').child(auth.uid).exists()))",
        // Admin may write any season in any status (authoring drafts, fixing archives).
        ".write": "auth != null && root.child('config/adminId').val() === auth.uid",

        // Player-level writes are allowed when the season is LIVE (active|closing),
        // or when it is a DRAFT and you are admin/alpha (playtesting).
        // Archived seasons are read-only to everyone but admin.

        "tiles": {
          "$coord": {
            "adventurers": {
              "$advId": {
                // TWO rules merged here; both intents are load-bearing.
                //
                // S2: JOINING IS SERVER-ONLY — a player may not CREATE an entry. Joining
                // goes through the joinChallenge / claimChallengeSlot callables, because
                // the config requirement is unenforceable in a rule: a database rule
                // cannot see a Storage object. The Admin SDK bypasses these rules, which
                // is how the callables write. This also retires the old pre-write trick
                // (claimableSlots still existing in `data` during the atomic update that
                // deleted it).
                //
                // The no-create test is the `owner` term ALONE, and deliberately so: on a
                // create there is no `data`, so owner is null and can never equal a uid.
                // Do NOT add `!newData.exists()` to express this — that forbids every
                // non-delete write, which silently kills setAdventurerStatusNote and makes
                // the statusNote .validate below unreachable.
                //
                // What this does NOT cover: an owner may still rewrite the slots of an
                // entry they already joined with, so the declared set can change after the
                // config was verified. Unavoidable here for the same Storage reason, and
                // the host reviews configs regardless.
                //
                // MERCS: a non-admin write must not drop a slot that has one. Because
                // .validate never runs on a DELETED node, the slots/0..9 terms here are
                // what stop an owner RECALLING an adventurer that holds a merced slot —
                // the per-slot rule below cannot see that case. Rules cannot iterate;
                // 0–9 is well past any adventurer’s slot count.
                //
                // Net effect: a player may delete their own entry, and only if no slot
                // on it is merced. Everything else is server-only.
                ".write": "auth != null && (root.child('config/adminId').val() === auth.uid || (((root.child('config/seasonList').child($seasonId).child('status').val() === 'active' || root.child('config/seasonList').child($seasonId).child('status').val() === 'closing') || (!root.child('config/seasonList').child($seasonId).exists() && root.child('config/alphaUsers').child(auth.uid).exists())) && data.child('owner').val() === auth.uid && ((!data.child('slots/0/merc').exists() || newData.child('slots/0').exists()) && (!data.child('slots/1/merc').exists() || newData.child('slots/1').exists()) && (!data.child('slots/2/merc').exists() || newData.child('slots/2').exists()) && (!data.child('slots/3/merc').exists() || newData.child('slots/3').exists()) && (!data.child('slots/4/merc').exists() || newData.child('slots/4').exists()) && (!data.child('slots/5/merc').exists() || newData.child('slots/5').exists()) && (!data.child('slots/6/merc').exists() || newData.child('slots/6').exists()) && (!data.child('slots/7/merc').exists() || newData.child('slots/7').exists()) && (!data.child('slots/8/merc').exists() || newData.child('slots/8').exists()) && (!data.child('slots/9/merc').exists() || newData.child('slots/9').exists()))))",
                ".validate": "!newData.exists() || root.child('config/adminId').val() === auth.uid || (((!data.child('slots/0/merc').exists() || newData.child('slots/0').exists()) && (!data.child('slots/1/merc').exists() || newData.child('slots/1').exists()) && (!data.child('slots/2/merc').exists() || newData.child('slots/2').exists()) && (!data.child('slots/3/merc').exists() || newData.child('slots/3').exists()) && (!data.child('slots/4/merc').exists() || newData.child('slots/4').exists()) && (!data.child('slots/5/merc').exists() || newData.child('slots/5').exists()) && (!data.child('slots/6/merc').exists() || newData.child('slots/6').exists()) && (!data.child('slots/7/merc').exists() || newData.child('slots/7').exists()) && (!data.child('slots/8/merc').exists() || newData.child('slots/8').exists()) && (!data.child('slots/9/merc').exists() || newData.child('slots/9').exists())) && newData.child('advId').val() === $advId)",
                "statusNote": {
                  ".validate": "!newData.exists() || (newData.hasChildren(['text', 'timestamp']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 280 && newData.child('timestamp').isNumber())"
                },
                // A merc is hired / replaced / removed only through the setSlotMerc
                // callable (Admin SDK, so rules don't apply to it). The owner can
                // otherwise rewrite their own adventurer entry, so pin the merc here:
                // a non-admin write must leave each slot's merc exactly as it was.
                // Removal is the case that matters — an owner who could drop their
                // merc could hire help early and boot it before settle.
                // (The slots/0..9 terms in the .write and .validate above are the other
                // half of this: .validate never runs on a DELETED node, so dropping the
                // merced slot, the slots list, or the whole adventurer would slip past
                // the per-slot rule here. Rules can't iterate; 0–9 is well past any
                // adventurer's slot count.)
                "slots": {
                  "$slotIdx": {
                    // ...and `claimed` may not be cleared either: it is what bars a
                    // claimant from passing the slot on to a merc.
                    ".validate": "root.child('config/adminId').val() === auth.uid || (newData.child('merc/playerId').val() === data.child('merc/playerId').val() && (data.child('claimed').val() !== true || newData.child('claimed').val() === true))"
                  }
                }
              }
            },
            "claimableSlots": {
              "$slotKey": {
                // Any eligible player may DELETE (claim) an existing slot, never create one.
                ".write": "auth != null && (root.child('config/adminId').val() === auth.uid || (((root.child('config/seasonList').child($seasonId).child('status').val() === 'active' || root.child('config/seasonList').child($seasonId).child('status').val() === 'closing') || (!root.child('config/seasonList').child($seasonId).exists() && root.child('config/alphaUsers').child(auth.uid).exists())) && !newData.exists() && data.exists()))"
              }
            }
          }
        },

        "players": {
          "$playerId": {
            ".validate": "root.child('config/adminId').val() === auth.uid || (newData.child('xp').val() === data.child('xp').val() && newData.child('gold').val() === data.child('gold').val())",

            "adventurers": {
              "$advId": {
                ".write": "auth != null && (root.child('config/adminId').val() === auth.uid || (auth.uid === $playerId && ((root.child('config/seasonList').child($seasonId).child('status').val() === 'active' || root.child('config/seasonList').child($seasonId).child('status').val() === 'closing') || (!root.child('config/seasonList').child($seasonId).exists() && root.child('config/alphaUsers').child(auth.uid).exists()))))"
              }
            },

            "nameColor": {
              ".write": "auth != null && (root.child('config/adminId').val() === auth.uid || (auth.uid === $playerId && ((root.child('config/seasonList').child($seasonId).child('status').val() === 'active' || root.child('config/seasonList').child($seasonId).child('status').val() === 'closing') || (!root.child('config/seasonList').child($seasonId).exists() && root.child('config/alphaUsers').child(auth.uid).exists()))))"
            },

            "feats": {
              "$slot": {
                ".write": "auth != null && (root.child('config/adminId').val() === auth.uid || (auth.uid === $playerId && ((root.child('config/seasonList').child($seasonId).child('status').val() === 'active' || root.child('config/seasonList').child($seasonId).child('status').val() === 'closing') || (!root.child('config/seasonList').child($seasonId).exists() && root.child('config/alphaUsers').child(auth.uid).exists()))))",
                // A feat slot may be filled once and never re-selected.
                ".validate": "newData.isString() && newData.val().length > 0 && (!data.exists() || root.child('config/adminId').val() === auth.uid)"
              }
            },

            "xp":   { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "gold": { ".validate": "newData.isNumber() && newData.val() >= 0" },

            // Middle player status: plays as normal, but claims are only returned
            // when the world resolves. Admin-only by construction — there is no
            // `.write` at or above this leaf except the season's admin one (the
            // player-writable leaves are adventurers / nameColor / feats), so this
            // is a shape guard, not the permission boundary. Cleared by writing
            // null, which skips .validate, so the tri-state never leaves a `false`.
            "restricted": { ".validate": "newData.isBoolean()" },

            "inventory": {
              "$itemId": { ".validate": "newData.isNumber() && newData.val() >= 0" }
            }
          }
        },

        "missions": {
          "$missionId": {
            "claimableSlots": {
              "$slotKey": {
                ".write": "auth != null && (root.child('config/adminId').val() === auth.uid || (((root.child('config/seasonList').child($seasonId).child('status').val() === 'active' || root.child('config/seasonList').child($seasonId).child('status').val() === 'closing') || (!root.child('config/seasonList').child($seasonId).exists() && root.child('config/alphaUsers').child(auth.uid).exists())) && !newData.exists() && data.exists()))"
              }
            }
          }
        },

        "notifications": {
          "$uid": {
            // Client deletes its own entries on receipt.
            ".write": "auth != null && (root.child('config/adminId').val() === auth.uid || (auth.uid === $uid && ((root.child('config/seasonList').child($seasonId).child('status').val() === 'active' || root.child('config/seasonList').child($seasonId).child('status').val() === 'closing') || (!root.child('config/seasonList').child($seasonId).exists() && root.child('config/alphaUsers').child(auth.uid).exists()))))"
          }
        }
      }
    },

    "profiles": {
      "players": {
        "$uid": {
          ".read":  true,
          ".write": false
        }
      },
      "handleIndex": {
        ".read":  true,
        ".write": false
      }
    },

    // Per-slot check-count history, sampled by tickSlotStatuses and read only by
    // the admin Report tab's room peek. Deliberately NOT under seasons/: that node
    // is streamed in full to every player by subscribeToGame, and this tree is
    // several times the size of the room totals that live there, to serve one
    // admin page reading one world at a time.
    //
    // Admin-only read (operational data; the Report tab is admin-only anyway) and
    // NOBODY may write — the scheduled tick uses the Admin SDK, which bypasses
    // rules, so there is no client write path to allow.
    "roomTelemetry": {
      ".read":  "auth != null && root.child('config/adminId').val() === auth.uid",
      ".write": false
    },

    "kmkEvents": {
      // Public read — the player trial board is viewable by anyone.
      ".read": true,

      "$listId": {
        // Admin may create, modify, or delete any list.
        ".write": "auth != null && root.child('config/adminId').val() === auth.uid",

        "areas": {
          "$areaId": {
            "tasks": {
              "$taskId": {
                // Admin: full write.
                // Player: may only touch their own claimed task that is not yet Complete.
                //   Mark Done  → Pending → Verifying    (status only)
                //   Resume     → Verifying → Pending    (status only)
                //   Abandon    → Pending|Verifying → Incomplete (clears player fields)
                // Claim (Incomplete → Pending) goes through kmkClaimTrial Cloud Function (admin SDK).
                ".write": "auth != null && (root.child('config/adminId').val() === auth.uid || (data.child('playerId').val() === auth.uid && data.child('status').val() !== 'Complete'))",
                ".validate": "root.child('config/adminId').val() === auth.uid || (newData.child('trial').val() === data.child('trial').val() && newData.child('desc').val() === data.child('desc').val() && newData.child('order').val() === data.child('order').val() && ((newData.child('status').val() === 'Incomplete' && newData.child('playerId').val() === null && newData.child('playerName').val() === null && newData.child('claimedAt').val() === null) || ((newData.child('status').val() === 'Pending' || newData.child('status').val() === 'Verifying') && newData.child('playerId').val() === auth.uid)))"
              }
            }
          }
        }
      }
    }
  }
}
